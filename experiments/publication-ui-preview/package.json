{
  "name": "hebrew-publication-ui-preview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build --mode runtime",
    "build:demo": "tsc --noEmit && vite build --mode demo",
    "preview": "vite preview --host 127.0.0.1 --port 4178 --strictPort",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "data:build": "python3 scripts/build_data.py",
    "data:check": "python3 scripts/build_data.py --check"
  },
  "dependencies": {
    "@heroui/react": "3.2.4",
    "@heroui/styles": "3.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@fontsource/noto-sans": "^5.0.0",
    "@fontsource/noto-sans-hebrew": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "vite": "^7.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/node": "^24.0.0"
  }
}
